Q-4 : Build RAM8 and RAM64 hierarchically. Demonstrate address

decomposition for RAM64: show how a 6-bit address maps to a RAM8

chip and a register within it.



RAM8 (8-Register 16-Bit Memory):-



HDL Implementation (RAM8.hdl):-


CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    // Route load signal to the selected register
    DMux8Way(in=load, sel=address, a=l0, b=l1, c=l2, d=l3, e=l4, f=l5, g=l6, h=l7);

    // Bank of 8 16-bit registers
    Register(in=in, load=l0, out=r0);
    Register(in=in, load=l1, out=r1);
    Register(in=in, load=l2, out=r2);
    Register(in=in, load=l3, out=r3);
    Register(in=in, load=l4, out=r4);
    Register(in=in, load=l5, out=r5);
    Register(in=in, load=l6, out=r6);
    Register(in=in, load=l7, out=r7);

    // Select output from the addressed register
    Mux8Way16(a=r0, b=r1, c=r2, d=r3, e=r4, f=r5, g=r6, h=r7, sel=address, out=out);
}


RAM64 (64-Register 16-Bit Hierarchical Memory):-


HDL Implementation (RAM64.hdl):-


CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    // Upper 3 bits (address[3..5]) select which RAM8 bank receives the load signal
    DMux8Way(in=load, sel=address[3..5], a=l0, b=l1, c=l2, d=l3, e=l4, f=l5, g=l6, h=l7);

    // Lower 3 bits (address[0..2]) select the register inside each RAM8 bank
    RAM8(in=in, load=l0, address=address[0..2], out=ram0);
    RAM8(in=in, load=l1, address=address[0..2], out=ram1);
    RAM8(in=in, load=l2, address=address[0..2], out=ram2);
    RAM8(in=in, load=l3, address=address[0..2], out=ram3);
    RAM8(in=in, load=l4, address=address[0..2], out=ram4);
    RAM8(in=in, load=l5, address=address[0..2], out=ram5);
    RAM8(in=in, load=l6, address=address[0..2], out=ram6);
    RAM8(in=in, load=l7, address=address[0..2], out=ram7);

    // Upper 3 bits (address[3..5]) select which RAM8 bank drives the final output
    Mux8Way16(a=ram0, b=ram1, c=ram2, d=ram3, e=ram4, f=ram5, g=ram6, h=ram7, sel=address[3..5], out=out);
}