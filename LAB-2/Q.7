      </tbody>
    </table>

    <h2>3. Complete Hack ALU Design &amp; 18-Function Truth Table</h2>
    <p>The Hack Arithmetic Logic Unit processes two 16-bit two&#39;s complement operands (<code>x[16]</code>, <code>y[16]</code>) through four combinational stages governed by six control bits: zeroing (<code>zx</code>, <code>zy</code>), input negation (<code>nx</code>, <code>ny</code>), function select (<code>f</code>: 1 = <code>Add16</code>, 0 = <code>And16</code>), and output negation (<code>no</code>), emitting <code>out[16]</code> along with zero (<code>zr</code>) and negative (<code>ng</code>) flags.</p>

    <pre>CHIP ALU {
    IN  x[16], y[16], zx, nx, zy, ny, f, no;
    OUT out[16], zr, ng;
    PARTS:
    Mux16(a=x, b=false, sel=zx, out=x1);
    Not16(in=x1, out=notx1);
    Mux16(a=x1, b=notx1, sel=nx, out=x2);

    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=noty1);
    Mux16(a=y1, b=noty1, sel=ny, out=y2);

    Add16(a=x2, b=y2, out=addxy);
    And16(a=x2, b=y2, out=andxy);
    Mux16(a=andxy, b=addxy, sel=f, out=fxy);

    Not16(in=fxy, out=notfxy);
    Mux16(a=fxy, b=notfxy, sel=no, out=out, out[0..7]=low8, out[8..15]=high8, out[15]=ng);

    Or8Way(in=low8, out=orlow);
    Or8Way(in=high8, out=orhigh);
    Or(a=orlow, b=orhigh, out=nonzero);
    Not(in=nonzero, out=zr);
}</pre>

